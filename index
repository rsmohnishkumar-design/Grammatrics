<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#18243f">
<meta name="description" content="Grammatrix — The Mega Grammar Learning Fest, Velammal Annex.">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>Grammatrix — The Mega Grammar Learning Fest</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<style>
:root{
--ink:#18243f;
--muted:#74819a;
--bg:#f4f7fc;
--surface:#fff;
--line:#e3e8f2;
--primary:#5a4ff2;
--primary2:#776df7;
--soft:#eeecff;
--cyan:#21b7c9;
--green:#16845b;
--greenSoft:#e4f8ef;
--red:#b53f56;
--redSoft:#ffe9ee;
--gold:#f2b94b;
--silver:#aeb7c7;
--bronze:#c48752;
--shadow:0 18px 55px rgba(28,43,78,.09);
--shadowLg:0 30px 90px rgba(15,27,55,.18)
}

*{
box-sizing:border-box;
margin:0;
padding:0
}

html{
scroll-behavior:smooth
}

body{
font-family:"DM Sans",sans-serif;
background:
radial-gradient(circle at 10% 20%,rgba(90,79,242,.06),transparent 24rem),
radial-gradient(circle at 90% 45%,rgba(33,183,201,.05),transparent 24rem),
var(--bg);
color:var(--ink);
line-height:1.55
}

button,input,select,textarea{
font:inherit
}

button{
cursor:pointer
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible{
outline:3px solid rgba(90,79,242,.25);
outline-offset:2px
}

.hero{
position:relative;
overflow:hidden;
color:#fff;
padding:24px 20px 88px;
background:
radial-gradient(circle at 16% 12%,rgba(119,109,247,.9),transparent 30%),
radial-gradient(circle at 86% 35%,rgba(33,183,201,.18),transparent 28%),
linear-gradient(135deg,#5548e8,#303d72 52%,#18243f)
}

.hero:before,
.hero:after{
content:"";
position:absolute;
border:1px solid rgba(255,255,255,.12);
border-radius:50%;
pointer-events:none
}

.hero:before{
width:390px;
height:390px;
right:-145px;
top:-175px
}

.hero:after{
width:260px;
height:260px;
left:-150px;
bottom:-180px
}

.topbar,
.hero-inner,
.shell,
.admin-inner{
max-width:1120px;
margin:auto
}

.topbar{
display:flex;
align-items:center;
justify-content:space-between;
position:relative;
z-index:2
}

.brand-mini{
display:flex;
align-items:center;
gap:9px;
font-weight:800;
letter-spacing:.08em;
font-size:.84rem
}

.brand-mark{
width:31px;
height:31px;
border-radius:10px;
display:grid;
place-items:center;
background:rgba(255,255,255,.13);
border:1px solid rgba(255,255,255,.18)
}

.due-pill{
display:flex;
align-items:center;
gap:7px;
border:1px solid rgba(255,255,255,.2);
background:rgba(255,255,255,.09);
padding:9px 13px;
border-radius:999px;
font-size:.78rem;
color:rgba(255,255,255,.9);
backdrop-filter:blur(8px);
cursor:pointer
}

.hero-inner{
text-align:center;
position:relative;
z-index:2;
margin-top:55px
}

.eyebrow{
font-size:.73rem;
letter-spacing:.2em;
text-transform:uppercase;
font-weight:700;
color:rgba(255,255,255,.72)
}

h1{
font-family:Manrope,sans-serif;
font-size:clamp(3.4rem,9vw,6.5rem);
line-height:.94;
letter-spacing:-.065em;
margin:13px 0 14px;
text-shadow:0 10px 35px rgba(0,0,0,.16)
}

.subtitle{
font-family:Manrope,sans-serif;
font-size:clamp(1.05rem,2.5vw,1.45rem);
font-weight:600;
color:rgba(255,255,255,.94)
}

.hero-note{
max-width:680px;
margin:17px auto 0;
color:rgba(255,255,255,.68);
font-size:.93rem
}

.shell{
margin-top:-46px;
padding:0 18px 65px;
position:relative;
z-index:3
}

.nav-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:16px;
max-width:760px;
margin:0 auto
}

.nav-card{
border:1px solid rgba(255,255,255,.85);
background:rgba(255,255,255,.97);
color:var(--ink);
border-radius:24px;
padding:23px;
text-align:left;
box-shadow:var(--shadow);
min-height:158px;
transition:transform .18s,box-shadow .18s
}

.nav-card:hover{
transform:translateY(-5px);
box-shadow:0 25px 65px rgba(28,43,78,.13)
}

.nav-icon{
width:45px;
height:45px;
border-radius:14px;
display:grid;
place-items:center;
margin-bottom:15px;
background:var(--soft);
color:var(--primary)
}

.nav-card:nth-child(2) .nav-icon{
background:#e5f8fa;
color:#1196a8
}

.nav-card h2{
font-family:Manrope,sans-serif;
font-size:1.08rem
}

.nav-card p{
color:var(--muted);
font-size:.84rem;
margin-top:5px
}

.section{
margin-top:28px
}

.section-head{
margin:39px 2px 15px
}

.section-head h2{
font-family:Manrope,sans-serif;
font-size:1.72rem;
letter-spacing:-.04em
}

.section-head p{
color:var(--muted);
font-size:.86rem;
margin-top:3px
}

.card{
background:#fff;
border:1px solid var(--line);
border-radius:28px;
box-shadow:var(--shadow);
padding:27px
}

.hidden{
display:none!important
}

.profile-bar{
display:flex;
align-items:center;
gap:12px;
background:#fff;
border:1px solid var(--line);
border-radius:18px;
padding:12px 15px;
margin:0 auto 24px;
max-width:760px
}

.profile-bar img,
.profile-avatar{
width:48px;
height:48px;
border-radius:50%;
object-fit:cover
}

.profile-avatar{
display:grid;
place-items:center;
background:var(--soft);
color:var(--primary);
font-weight:800
}

.profile-info{
flex:1
}

.profile-info b{
font-family:Manrope
}

.profile-info small{
display:block;
color:var(--muted)
}

.profile-setup{
max-width:560px;
margin:0 auto 25px
}

.profile-setup h2{
font-family:Manrope;
margin-bottom:5px
}

.profile-setup p{
color:var(--muted);
font-size:.88rem;
margin-bottom:17px
}

.field{
margin:10px 0
}

.field label{
display:block;
font-size:.76rem;
font-weight:800;
margin-bottom:5px
}

.field input,
.field textarea,
.field select{
width:100%;
padding:11px 12px;
border:1px solid var(--line);
border-radius:11px;
background:#fbfcff;
color:var(--ink)
}

.btn{
border:0;
border-radius:12px;
padding:11px 16px;
font-weight:700;
transition:.15s;
display:inline-flex;
align-items:center;
gap:7px;
justify-content:center
}

.btn.primary{
background:var(--primary);
color:#fff
}

.btn.secondary{
background:#eef1f7;
color:var(--ink)
}

.btn.danger{
background:#ffe9ee;
color:#a62f47
}

.btn:disabled{
opacity:.45;
cursor:not-allowed
}

.btn-row{
display:flex;
gap:9px;
flex-wrap:wrap;
margin-top:14px
}

.info-overlay,
.login-overlay,
.intro-overlay,
.profile-overlay{
position:fixed;
inset:0;
background:rgba(10,18,39,.64);
backdrop-filter:blur(7px);
display:none;
align-items:center;
justify-content:center;
z-index:100;
padding:18px
}

.info-overlay.open,
.login-overlay.open,
.intro-overlay.open,
.profile-overlay.open{
display:flex
}

.modal{
width:min(620px,100%);
max-height:90vh;
overflow:auto;
background:#fff;
border-radius:28px;
box-shadow:var(--shadowLg);
padding:27px;
position:relative
}

.modal h2{
font-family:Manrope;
font-size:1.55rem
}

.modal .lead{
color:var(--muted);
font-size:.9rem;
margin:5px 0 18px
}

.close{
position:absolute;
right:16px;
top:16px;
border:0;
background:#f0f2f7;
border-radius:10px;
width:38px;
height:38px;
font-size:20px
}

.info-list{
display:grid;
gap:10px
}

.info-step{
display:grid;
grid-template-columns:30px 1fr;
gap:10px;
align-items:start;
padding:12px;
border:1px solid var(--line);
border-radius:14px;
background:#fafbfe
}

.info-step b{
width:28px;
height:28px;
display:grid;
place-items:center;
border-radius:9px;
background:var(--soft);
color:var(--primary);
font-size:.75rem
}

.info-step p{
font-size:.84rem;
color:#52617c
}

.info-note{
padding:13px 14px;
border-radius:14px;
background:#f3f5fa;
color:#52617c;
font-size:.81rem;
margin-top:15px
}

.challenge-card{
background:#fff;
border:1px solid var(--line);
border-radius:28px;
box-shadow:var(--shadow);
padding:27px;
max-width:820px;
margin:auto
}

.progress-row{
display:flex;
justify-content:space-between;
color:var(--muted);
font-size:.79rem;
margin-bottom:13px
}

.progress{
height:8px;
background:#edf0f6;
border-radius:999px;
overflow:hidden
}

.progress i{
display:block;
height:100%;
background:linear-gradient(90deg,var(--primary),var(--primary2));
border-radius:999px
}

.question-number{
display:inline-flex;
margin-top:21px;
padding:6px 9px;
border-radius:8px;
background:var(--soft);
color:var(--primary);
font-size:.69rem;
font-weight:800;
letter-spacing:.12em;
text-transform:uppercase
}

.question{
font-family:Manrope;
font-size:clamp(1.2rem,3vw,1.72rem);
font-weight:800;
line-height:1.3;
margin:10px 0 20px
}

.options{
display:grid;
gap:10px
}

.option{
width:100%;
text-align:left;
border:1px solid var(--line);
background:#f8faff;
padding:15px 16px;
border-radius:15px;
color:var(--ink)
}

.option.correct{
background:var(--greenSoft);
border-color:#b7e9d1
}

.option.wrong{
background:var(--redSoft);
border-color:#ffd0da
}

.option:disabled{
cursor:default
}

.option-label{
font-weight:800;
margin-right:9px;
color:var(--primary)
}

.answer-msg{
min-height:28px;
margin-top:13px;
font-size:.89rem;
font-weight:700
}

.success{
color:var(--green)
}

.error{
color:var(--red)
}

.challenge-actions{
display:flex;
gap:10px;
justify-content:space-between;
margin-top:16px
}

.puzzle-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:16px
}

.puzzle{
background:#fff;
border:1px solid var(--line);
border-radius:23px;
padding:22px;
box-shadow:0 12px 38px rgba(28,38,68,.06)
}

.puzzle h3{
font-family:Manrope;
margin:12px 0 7px
}

.puzzle p{
color:var(--muted);
font-size:.88rem
}

.puzzle input{
width:100%;
padding:11px;
border:1px solid var(--line);
border-radius:11px;
margin-top:12px
}

.puzzle-solution{
margin-top:11px;
padding:11px 12px;
border-radius:12px;
background:#f3f5fa;
color:#52617c;
font-size:.84rem
}

.definition-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:12px
}

.definition{
border:1px solid var(--line);
border-radius:17px;
padding:17px;
background:#fafbfe
}

.definition h3{
font-family:Manrope;
font-size:1rem
}

.definition p{
color:#52617c;
font-size:.84rem;
margin-top:5px
}

.example{
margin-top:8px;
font-size:.78rem;
color:var(--primary);
background:var(--soft);
padding:8px 10px;
border-radius:9px
}

.leaderboard{
display:grid;
gap:10px
}

.leader{
display:flex;
align-items:center;
gap:12px;
padding:13px;
border:1px solid var(--line);
border-radius:16px;
background:#fff
}

.rank{
width:34px;
text-align:center;
font-weight:900
}

.leader img,
.leader-avatar{
width:48px;
height:48px;
border-radius:50%;
object-fit:cover
}

.leader-avatar{
display:grid;
place-items:center;
background:var(--soft);
color:var(--primary);
font-weight:800
}

.leader-main{
flex:1
}

.leader-main b{
font-family:Manrope
}

.leader-main small{
display:block;
color:var(--muted)
}

.score{
font-weight:900
}

.gold{
border-color:#efd18a;
background:#fffaf0
}

.silver{
border-color:#d3d8e0;
background:#fafbfd
}

.bronze{
border-color:#e4c0a1;
background:#fff9f5
}

.feedback-fab{
position:fixed;
right:18px;
bottom:18px;
width:52px;
height:52px;
border:0;
border-radius:50%;
background:var(--primary);
color:#fff;
box-shadow:0 12px 35px rgba(90,79,242,.35);
z-index:80;
font-size:22px;
transition:width .2s,height .2s,font-size .2s,opacity .2s
}

.feedback-fab.small{
width:32px;
height:32px;
font-size:14px;
opacity:.7;
box-shadow:0 8px 20px rgba(90,79,242,.28)
}

.star-rating{
display:flex;
gap:6px;
font-size:1.7rem;
line-height:1
}

.star{
background:none;
border:0;
padding:0;
color:#d8dce8;
cursor:pointer;
transition:color .12s,transform .12s
}

.star:hover{
transform:scale(1.12)
}

.star.active{
color:var(--gold)
}

.empty{
background:#fff;
border:1px dashed #cfd6e4;
border-radius:22px;
padding:30px;
text-align:center;
color:var(--muted)
}

#secretHit{
position:fixed;
left:7px;
bottom:7px;
width:12px;
height:12px;
opacity:.015;
border:0;
background:#000;
z-index:99
}

.admin{
display:none;
position:fixed;
inset:0;
z-index:90;
overflow:auto;
background:#0e172b;
color:#edf2ff
}

.admin.open{
display:block
}

.admin-inner{
padding:25px 18px 55px
}

.admin-top{
display:flex;
justify-content:space-between;
align-items:center;
gap:15px;
margin-bottom:22px
}

.admin-brand{
display:flex;
align-items:center;
gap:10px
}

.admin-sub{
color:#9ca9c1;
font-size:.8rem
}

.admin-card{
background:#17223a;
border:1px solid #293754;
border-radius:20px;
padding:20px;
margin:14px 0
}

.admin-card h3{
margin-bottom:13px;
font-family:Manrope
}

.admin label{
display:block;
font-size:.75rem;
color:#aeb8ce;
margin:9px 0 5px
}

.admin input,
.admin textarea,
.admin select{
width:100%;
border:1px solid #35415d;
background:#0e1729;
color:#fff;
border-radius:10px;
padding:10px 11px
}

.admin textarea{
min-height:80px;
resize:vertical
}

.admin-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:12px
}

.sheet{
width:100%;
border-collapse:collapse;
font-size:.78rem
}

.sheet th,
.sheet td{
border:1px solid #35415d;
padding:8px;
text-align:left;
vertical-align:top
}

.sheet th{
background:#202c48;
color:#bfc9dc
}

.sheet td{
color:#eaf0ff
}

.mini{
padding:6px 9px;
border-radius:8px;
border:0;
background:#2b3959;
color:#fff;
margin:2px
}

.status{
font-size:.8rem;
margin-top:9px;
color:#9ca8bd
}

.status.success{
color:#54d39b
}

.status.error{
color:#ff9aaa
}

.parser{
border:1px solid #35415d;
background:#111b30;
padding:14px;
border-radius:14px;
margin-bottom:15px
}

.parser textarea{
min-height:180px
}

.admin-note{
font-size:.73rem;
color:#8794ad;
margin-top:9px
}

.lock-dot{
width:10px;
height:10px;
border-radius:50%;
background:#66738c;
border:0;
padding:0;
display:inline-block;
margin-left:5px
}

.feedback-admin{
display:grid;
gap:10px
}

.feedback-item{
padding:13px;
border:1px solid #35415d;
border-radius:12px;
background:#111b30
}

.feedback-item small{
color:#8e9ab0;
display:block;
margin-top:4px
}

.intro-content{
text-align:center
}

.intro-logo{
font-family:Manrope;
font-size:2.5rem;
font-weight:900;
color:var(--primary);
letter-spacing:-.06em
}

.intro-content p{
color:var(--muted);
margin:12px auto;
max-width:480px
}

.welcome-icon{
font-size:3rem;
margin-bottom:8px
}

footer{
text-align:center;
padding:35px 20px 55px;
color:var(--muted);
font-size:.82rem
}

@media(max-width:760px){

.nav-grid,
.puzzle-grid,
.definition-grid,
.admin-grid{
grid-template-columns:1fr
}

.hero{
padding:21px 14px 80px
}

.shell{
padding:0 12px 42px
}

.challenge-card{
padding:18px
}

.challenge-actions{
flex-direction:column
}

.challenge-actions .btn{
width:100%
}

.admin-inner{
padding:17px 12px 40px
}

.sheet{
display:block;
overflow-x:auto;
white-space:nowrap
}

.profile-bar{
margin-left:0;
margin-right:0
}

}
</style>
</head>

<body>

<header class="hero">

<div class="topbar">

<div class="brand-mini">
<span class="brand-mark">G</span>
GRAMMATRIX
</div>

<button class="due-pill" id="dueIndicator">
⏱ Due <strong id="publicDueDate">Not announced</strong>
</button>

</div>

<div class="hero-inner">

<div class="eyebrow">Velammal Annex</div>

<h1>Grammatrix</h1>

