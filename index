function parseQuestion(raw){

const text=
raw
.replace(/\r/g,"")
.trim();

if(!text)
throw new Error("Paste a question first.");

const ansMatch=
text.match(
/(?:^|\n)\s*(?:ans(?:wer)?|correct\s*answer)\s*[:\-]\s*([ABCD])\b/i
);

const expMatch=
text.match(
/(?:^|\n)\s*explanation\s*[:\-]?\s*([\s\S]*)$/i
);

let body=text;

if(expMatch)
body=body
.slice(0,expMatch.index)
.trim();

if(ansMatch)
body=body
.replace(ansMatch[0],"")
.trim();


const optRe=
/(?:^|\n)\s*(?:option\s*)?([ABCD])\s*[\)\.\:\-]\s*([^\n]+)/gi;

const opts={
A:"",
B:"",
C:"",
D:""
};

const matches=[
...body.matchAll(optRe)
];


matches.forEach(m=>
opts[m[1].toUpperCase()]=
m[2].trim()
);


if(
Object.values(opts).some(v=>!v)
){

const lines=
body
.split("\n")
.map(x=>x.trim())
.filter(Boolean);

const pos=
lines.findIndex(
x=>
/^(?:option\s*)?a\s*[\)\.\:\-]/i.test(x)
);

if(pos>=0&&lines.length>=pos+4)

["A","B","C","D"]
.forEach((k,j)=>
opts[k]=
lines[pos+j]
.replace(
/^(?:option\s*)?[ABCD]\s*[\)\.\:\-]\s*/i,
""
)
.trim()
);

}


const qEnd=
matches.length
?matches[0].index
:body.length;

let q=
body
.slice(0,qEnd)
.replace(/^\s*\d+\s*[\.\)]\s*/,"")
.trim();

if(!q)
throw new Error(
"Could not detect the question text."
);

if(
Object.values(opts).some(v=>!v)
)
throw new Error(
"Could not detect all four options A–D."
);

const correct=
ansMatch
?ansMatch[1].toUpperCase()
:"A";

const explanation=
expMatch
?expMatch[1].trim()
:"";

return {

question:q,

options:[
opts.A,
opts.B,
opts.C,
opts.D
],

correctIndex:
"ABCD".indexOf(correct),

explanation

};

}


